# Database - PostgreSQL (match schema.prisma provider)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/studylink?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT - REPLACE WITH STRONG RANDOM SECRETS (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_ME_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="REPLACE_ME_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_32_CHARS"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Email (for password reset - configure with your email provider)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
EMAIL_FROM="StudyLink <noreply@studylink.edu.ph>"